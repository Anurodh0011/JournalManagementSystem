@page "/add"
@layout MainLayout

@using Microsoft.JSInterop
@using MudBlazor
@using JournalManagementSystem.Services
@using JournalManagementSystem.Entities
@using JournalManagementSystem.Model
@inject IJSRuntime JS
@inject IJournalService JournalService
@inject UserSessionService UserSession
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudPaper Class="pa-4">
    <MudForm @ref="_form">
        <MudTextField @bind-Value="_model.Title"
                      Label="Title"
                      Required="true"
                      RequiredError="Title is required" />

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">
                Description
            </MudText>
            <div id="@EditorId"
                 style="height:200px; background:white; border:1px solid #ccc; border-radius:4px">
            </div>

        <MudSelect T="string"
                   Label="Primary Mood Category"
                   Required="true"
                   RequiredError="Primary mood category is required"
                   Value="_model.PrimaryMood"
                   ValueChanged="OnPrimaryMoodChanged"
                   Class="mt-4">

            @foreach (var category in PrimaryMoodCategories)
            {
                <MudSelectItem Value="@category">@category</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="string"
                   Label="Secondary Moods (max 2)"
                   MultiSelection="true"
                   Disabled="@string.IsNullOrEmpty(_model.PrimaryMood)"
                   SelectedValues="_secondaryMoods"
                   SelectedValuesChanged="OnSecondaryMoodsChanged"
                   Class="mt-4">

            @foreach (var mood in AvailableSecondaryMoods)
            {
                <MudSelectItem Value="@mood">@mood</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="string"
           Label="Tags (Optional)"
           MultiSelection="true"
           SelectedValues="_selectedTags"
           SelectedValuesChanged="OnTagsChanged"
           AllowCustomValues="true"         
           CustomValueAllowed="true"
           CustomValue="OnCustomTagAdded"   
           Class="mt-4">

    @foreach (var tag in PredefinedTags)
    {
        <MudSelectItem Value="@tag">@tag</MudSelectItem>
    }
</MudSelect>



        <MudText Typo="Typo.caption" Class="mt-2 text-danger">@formMessage</MudText>

        <MudButton Color="Color.Primary" Class="mt-4" OnClick="Save">Save</MudButton>
        <MudButton Color="Color.Default" Class="mt-4 ml-2" OnClick="Cancel">Cancel</MudButton>
    </MudForm>
</MudPaper>

@code {
    private MudForm? _form;
    private JournalViewModel _model = new();
    private HashSet<string> _secondaryMoods = new();
    private HashSet<string> _selectedTags = new();
    private string EditorId { get; set; } = $"quill-editor-{Guid.NewGuid()}";
    
    private string[] PrimaryMoodCategories = new[]
 {
    "Positive",
    "Neutral",
    "Negative"
};
    
    private Dictionary<string, string[]> SecondaryMoodMap = new()
    {
        ["Positive"] = new[]
    {
        "Happy", "Excited", "Relaxed", "Grateful", "Confident"
    },
        ["Neutral"] = new[]
    {
        "Calm", "Thoughtful", "Curious", "Nostalgic", "Bored"
    },
        ["Negative"] = new[]
    {
        "Sad", "Angry", "Stressed", "Lonely", "Anxious"
    }
    };

    private string[] PredefinedTags = new[]
    {
        "Work", "Career", "Studies", "Family", "Friends", "Relationships",
        "Health", "Fitness", "Personal Growth", "Self-care", "Hobbies", "Travel",
        "Nature", "Finance", "Spirituality", "Birthday", "Holiday", "Vacation",
        "Celebration", "Exercise", "Reading", "Writing", "Cooking", "Meditation",
        "Yoga", "Music", "Shopping", "Parenting", "Projects", "Planning", "Reflection"
    };

    private string formMessage = "";

    private void OnPrimaryMoodChanged(string value)
    {
        _model.PrimaryMood = value;

        // Clear secondary moods when category changes
        _secondaryMoods.Clear();
        _model.SecondaryMoods.Clear();
    }


    private IEnumerable<string> AvailableSecondaryMoods =>
    !string.IsNullOrEmpty(_model.PrimaryMood) &&
    SecondaryMoodMap.ContainsKey(_model.PrimaryMood)
        ? SecondaryMoodMap[_model.PrimaryMood]
        : Enumerable.Empty<string>();

    private void OnSecondaryMoodsChanged(IEnumerable<string> selectedMoods)
    {
        var moodsList = selectedMoods.ToList();

        if (moodsList.Count > 2)
        {
            _secondaryMoods = moodsList
                .Skip(moodsList.Count - 2)
                .ToHashSet();
        }
        else
        {
            _secondaryMoods = moodsList.ToHashSet();
        }

        _model.SecondaryMoods = _secondaryMoods.ToList();
    }


    private void OnTagsChanged(IEnumerable<string> selectedTags)
    {
        _selectedTags = selectedTags.ToHashSet();
        _model.Tags = _selectedTags.ToList();
    }

    private void OnCustomTagAdded(string customTag)
    {
        // Trim extra spaces
        customTag = customTag.Trim();
        if (string.IsNullOrWhiteSpace(customTag)) return;

        // Add custom tag to selected tags if not already there
        if (!_selectedTags.Contains(customTag))
        {
            _selectedTags.Add(customTag);
        }

        // Optional: Add it to PredefinedTags for future selection
        if (!PredefinedTags.Contains(customTag))
        {
            PredefinedTags = PredefinedTags.Append(customTag).ToArray();
        }

        // Sync selected tags to model
        _model.Tags = _selectedTags.ToList();
    }



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
    if (firstRender)
    {
        await JS.InvokeVoidAsync("initQuill", EditorId);

        // Load existing description if editing
        if (!string.IsNullOrEmpty(_model.Description))
        {
            await JS.InvokeVoidAsync("setQuillHtml", _model.Description);
        }

        _model.CreatedAt = DateTime.Today;
    }
}


    private async Task Save()
{
    await _form!.Validate();

    if (!_form.IsValid) return;

    if (!UserSession.IsLoggedIn)
    {
        formMessage = "You must be logged in to save a journal.";
        return;
    }

    _model.Description = await JS.InvokeAsync<string>("getQuillHtml", EditorId);

    _model.SecondaryMoods = _secondaryMoods.ToList();
    _model.Tags = _selectedTags.ToList();

    var userId = UserSession.CurrentUser!.Id;
    var response = await JournalService.AddOrUpdateJournalAsync(userId, _model);

    if (response.Success)
    {
        Snackbar.Add("Journal saved successfully!", Severity.Success);

        // Optional: clear editor after save
        await JS.InvokeVoidAsync("clearQuillEditor");
        _secondaryMoods.Clear();
        _selectedTags.Clear();
        _model = new JournalViewModel { CreatedAt = DateTime.Today };

        StateHasChanged();
        Navigation.NavigateTo("/journals");
    }
    else
    {
        formMessage = response.ErrorMessage ?? "Error saving journal.";
    }
}


    private void Cancel()
    {
        Navigation.NavigateTo("/journals");
    }
}