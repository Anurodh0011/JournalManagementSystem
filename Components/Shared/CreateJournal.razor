@page "/add"
@page "/edit/{Id:int}"
@layout MainLayout

@using Microsoft.JSInterop
@using MudBlazor
@using JournalManagementSystem.Services
@using JournalManagementSystem.Entities
@using JournalManagementSystem.Model

@inject IJSRuntime JS
@inject IJournalService JournalService
@inject UserSessionService UserSession
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudPaper Class="pa-4">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudForm @ref="_form">

            <MudText Typo="Typo.h6">
                @(IsEditMode ? "Edit Journal" : "Create Journal")
            </MudText>

            <MudTextField @bind-Value="_model.Title"
                          Label="Title"
                          Required="true"
                          RequiredError="Title is required"
                          Class="mt-3" />

            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Description</MudText>
            <div id="@EditorId"
                 style="height:200px; background:white; border:1px solid #ccc; border-radius:4px">
            </div>

            <!-- Primary Mood -->
            <MudSelect T="string"
                       Label="Primary Mood Category"
                       Required="true"
                       RequiredError="Primary mood category is required"
                       Value="_model.PrimaryMood"
                       ValueChanged="OnPrimaryMoodChanged"
                       Class="mt-4">

                @foreach (var category in PrimaryMoodCategories)
                {
                    <MudSelectItem Value="@category">@category</MudSelectItem>
                }
            </MudSelect>

            <!-- Secondary Moods -->
            <MudSelect T="string"
                       Label="Secondary Moods (max 2)"
                       MultiSelection="true"
                       Disabled="@string.IsNullOrEmpty(_model.PrimaryMood)"
                       SelectedValues="_secondaryMoods"
                       SelectedValuesChanged="OnSecondaryMoodsChanged"
                       Class="mt-4">

                @foreach (var mood in AvailableSecondaryMoods)
                {
                    <MudSelectItem Value="@mood">@mood</MudSelectItem>
                }
            </MudSelect>

            <!-- Tags -->
            <MudSelect T="string"
                       Label="Tags (Optional)"
                       MultiSelection="true"
                       SelectedValues="_selectedTags"
                       SelectedValuesChanged="OnTagsChanged"
                       AllowCustomValues="true"
                       CustomValueAllowed="true"
                       CustomValue="OnCustomTagAdded"
                       Class="mt-4">

                @foreach (var tag in PredefinedTags)
                {
                    <MudSelectItem Value="@tag">@tag</MudSelectItem>
                }
            </MudSelect>

            <MudText Typo="Typo.caption" Class="mt-2 text-danger">@formMessage</MudText>

            <MudButton Color="Color.Primary"
                       Class="mt-4"
                       OnClick="Save">
                @(IsEditMode ? "Update" : "Save")
            </MudButton>

            <MudButton Color="Color.Default"
                       Class="mt-4 ml-2"
                       OnClick="Cancel">
                Cancel
            </MudButton>

        </MudForm>
    }
</MudPaper>


@code {
    [Parameter] public int? Id { get; set; }

    private bool IsEditMode => Id.HasValue;

    private bool _loading = true;
    private MudForm? _form;
    private JournalViewModel _model = new();

    private HashSet<string> _secondaryMoods = new();
    private HashSet<string> _selectedTags = new();

    private string EditorId = $"quill-editor-{Guid.NewGuid()}";
    private string formMessage = "";

    private string[] PrimaryMoodCategories =
    {
        "Positive", "Neutral", "Negative"
    };

    private Dictionary<string, string[]> SecondaryMoodMap = new()
    {
        ["Positive"] = new[] { "Happy", "Excited", "Relaxed", "Grateful", "Confident" },
        ["Neutral"] = new[] { "Calm", "Thoughtful", "Curious", "Nostalgic", "Bored" },
        ["Negative"] = new[] { "Sad", "Angry", "Stressed", "Lonely", "Anxious" }
    };

    private string[] PredefinedTags =
    {
        "Work","Career","Studies","Family","Friends","Relationships","Health",
        "Fitness","Personal Growth","Self-care","Hobbies","Travel","Nature",
        "Finance","Spirituality","Birthday","Holiday","Vacation","Celebration",
        "Exercise","Reading","Writing","Cooking","Meditation","Yoga","Music",
        "Shopping","Parenting","Projects","Planning","Reflection"
    };

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (IsEditMode)
            await LoadJournalAsync();

        _loading = false;
    }

    private async Task LoadJournalAsync()
    {
        var userId = UserSession.CurrentUser!.Id;
        var (journals, _) = await JournalService.GetAllJournalsByUserAsync(userId, 1, 1000);

        var journal = journals.FirstOrDefault(j => j.JournalId == Id);
        if (journal == null)
        {
            Navigation.NavigateTo("/journals");
            return;
        }

        _model = new JournalViewModel
        {
            JournalId = journal.JournalId,
            Title = journal.Title,
            Description = journal.Description,
            PrimaryMood = journal.PrimaryMood,
            SecondaryMoods = journal.SecondaryMoods ?? new(),
            Tags = journal.Tags ?? new(),
            CreatedAt = journal.CreatedAt
        };

        _secondaryMoods = _model.SecondaryMoods.ToHashSet();
        _selectedTags = _model.Tags.ToHashSet();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initQuill", EditorId);

            if (!string.IsNullOrEmpty(_model.Description))
            {
                await JS.InvokeVoidAsync("setQuillHtml", EditorId, _model.Description);
            }

            if (!IsEditMode)
                _model.CreatedAt = DateTime.Today;
        }
    }

    private IEnumerable<string> AvailableSecondaryMoods =>
        !string.IsNullOrEmpty(_model.PrimaryMood) &&
        SecondaryMoodMap.ContainsKey(_model.PrimaryMood)
            ? SecondaryMoodMap[_model.PrimaryMood]
            : Enumerable.Empty<string>();

    private void OnPrimaryMoodChanged(string value)
    {
        _model.PrimaryMood = value;
        _secondaryMoods.Clear();
        _model.SecondaryMoods.Clear();
    }

    private void OnSecondaryMoodsChanged(IEnumerable<string> moods)
    {
        var list = moods.TakeLast(2).ToHashSet();
        _secondaryMoods = list;
        _model.SecondaryMoods = list.ToList();
    }

    private void OnTagsChanged(IEnumerable<string> tags)
    {
        _selectedTags = tags.ToHashSet();
        _model.Tags = _selectedTags.ToList();
    }

    private void OnCustomTagAdded(string tag)
    {
        tag = tag.Trim();
        if (string.IsNullOrWhiteSpace(tag)) return;

        _selectedTags.Add(tag);

        if (!PredefinedTags.Contains(tag))
            PredefinedTags = PredefinedTags.Append(tag).ToArray();

        _model.Tags = _selectedTags.ToList();
    }

    private async Task Save()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        _model.Description = await JS.InvokeAsync<string>("getQuillHtml", EditorId);

        var userId = UserSession.CurrentUser!.Id;
        var response = await JournalService.AddOrUpdateJournalAsync(userId, _model);

        if (response.Success)
        {
            Snackbar.Add(IsEditMode
                ? "Journal updated successfully!"
                : "Journal saved successfully!", Severity.Success);

            Navigation.NavigateTo("/journals");
        }
        else
        {
            formMessage = response.ErrorMessage ?? "Failed to save journal.";
        }
    }

    private void Cancel() => Navigation.NavigateTo("/journals");
}
