@page "/edit/{Id:int}"
@layout MainLayout

@using Microsoft.JSInterop
@using MudBlazor
@using JournalManagementSystem.Services
@using JournalManagementSystem.Entities
@using JournalManagementSystem.Model

@inject IJSRuntime JS
@inject IJournalService JournalService
@inject UserSessionService UserSession
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudPaper Class="pa-4">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_model == null)
    {
        <MudText>Journal not found</MudText>
    }
    else
    {
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_model.Title"
                          Label="Title"
                          Required="true"
                          RequiredError="Title is required" />

            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Description</MudText>
            <div id="@EditorId" style="height:200px; background:white; border:1px solid #ccc; border-radius:4px">
            </div>

            <MudSelect T="string"
                       Label="Primary Mood"
                       Required="true"
                       RequiredError="Primary mood is required"
                       @bind-Value="_model.PrimaryMood"
                       Class="mt-4">
                @foreach (var mood in PrimaryMoods)
                {
                    <MudSelectItem T="string" Value="@mood">@mood</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string"
                       Label="Secondary Moods (max 2)"
                       MultiSelection="true"
                       SelectedValues="_secondaryMoods"
                       SelectedValuesChanged="OnSecondaryMoodsChanged"
                       Class="mt-4">
                @foreach (var mood in SecondaryMoods)
                {
                    <MudSelectItem T="string" Value="@mood">@mood</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string"
                       Label="Tags"
                       MultiSelection="true"
                       SelectedValues="_selectedTags"
                       SelectedValuesChanged="OnTagsChanged"
                       Class="mt-4">
                @foreach (var tag in PredefinedTags)
                {
                    <MudSelectItem T="string" Value="@tag">@tag</MudSelectItem>
                }
            </MudSelect>

            <MudText Typo="Typo.caption" Class="mt-2 text-danger">@formMessage</MudText>

            <MudButton Color="Color.Primary" Class="mt-4" OnClick="Save">Update</MudButton>
            <MudButton Color="Color.Default" Class="mt-4 ml-2" OnClick="Cancel">Cancel</MudButton>
        </MudForm>
    }
</MudPaper>

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private MudForm? _form;
    private JournalViewModel _model = new();
    private HashSet<string> _secondaryMoods = new();
    private HashSet<string> _selectedTags = new();
    private string EditorId { get; set; } = $"quill-editor-{Guid.NewGuid()}";

    private string[] PrimaryMoods = new[]
    {
        "Happy", "Sad", "Anxious", "Calm", "Excited", "Angry", "Grateful", "Stressed", "Peaceful", "Confused"
    };

    private string[] SecondaryMoods = new[]
    {
        "Hopeful", "Tired", "Energetic", "Lonely", "Loved", "Frustrated", "Inspired", "Bored", "Proud", "Ashamed"
    };

    private string[] PredefinedTags = new[]
    {
        "Work", "Career", "Studies", "Family", "Friends", "Relationships", "Health", "Fitness", "Personal Growth",
        "Self-care", "Hobbies", "Travel", "Nature", "Finance", "Spirituality", "Birthday", "Holiday", "Vacation",
        "Celebration", "Exercise", "Reading", "Writing", "Cooking", "Meditation", "Yoga", "Music", "Shopping",
        "Parenting", "Projects", "Planning", "Reflection"
    };

    private string formMessage = "";

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadJournalAsync();
    }

    private async Task LoadJournalAsync()
    {
        var userId = UserSession.CurrentUser!.Id;
        var (journals, _) = await JournalService.GetAllJournalsByUserAsync(userId, 1, 1000);
        var journal = journals.FirstOrDefault(j => j.JournalId == Id);

        if (journal != null)
        {
            _model = new JournalViewModel
            {
                Title = journal.Title,
                Description = journal.Description,
                PrimaryMood = journal.PrimaryMood,
                SecondaryMoods = journal.SecondaryMoods ?? new List<string>(),
                Tags = journal.Tags ?? new List<string>(),
                CreatedAt = journal.CreatedAt
            };

            _secondaryMoods = _model.SecondaryMoods.ToHashSet();
            _selectedTags = _model.Tags.ToHashSet();
        }

        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _model != null)
        {
            await JS.InvokeVoidAsync("initQuill", EditorId);
            await Task.Delay(100); // Small delay to ensure Quill is initialized
            await JS.InvokeVoidAsync("setQuillHtml", EditorId, _model.Description);
        }
    }

    private void OnSecondaryMoodsChanged(IEnumerable<string> selectedMoods)
    {
        var moodsList = selectedMoods.ToList();
        if (moodsList.Count > 2)
        {
            _secondaryMoods = moodsList.Skip(moodsList.Count - 2).ToHashSet();
        }
        else
        {
            _secondaryMoods = moodsList.ToHashSet();
        }

        _model.SecondaryMoods = _secondaryMoods.ToList();
    }

    private void OnTagsChanged(IEnumerable<string> selectedTags)
    {
        _selectedTags = selectedTags.ToHashSet();
        _model.Tags = _selectedTags.ToList();
    }

    private async Task Save()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        if (!UserSession.IsLoggedIn)
        {
            formMessage = "You must be logged in to save a journal.";
            return;
        }

        _model.Description = await JS.InvokeAsync<string>("getQuillHtml", EditorId);
        _model.SecondaryMoods = _secondaryMoods.ToList();
        _model.Tags = _selectedTags.ToList();

        var userId = UserSession.CurrentUser!.Id;
        var response = await JournalService.AddOrUpdateJournalAsync(userId, _model);

        if (response.Success)
        {
            Snackbar.Add("Journal updated successfully!", Severity.Success);
            Navigation.NavigateTo("/journals");
        }
        else
        {
            formMessage = response.ErrorMessage ?? "Error updating journal.";
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/journals");
    }
}
