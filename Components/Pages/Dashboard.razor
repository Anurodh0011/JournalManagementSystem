@page "/"
@page "/dashboard"
@layout MainLayout
@using MudBlazor

<MudGrid Spacing="3">

    @* stats card *@
    <MudItem xs="12" md="3">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudStack Row="true" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.MenuBook"
                             Color="Color.Info"
                             Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.caption">Total Entries</MudText>
                        <MudText Typo="Typo.h4">48</MudText>
                    </div>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="3">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudStack Row="true" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment"
                             Color="Color.Error"
                             Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.caption">Current Streak</MudText>
                        <MudText Typo="Typo.h4">5 days</MudText>
                    </div>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="3">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudStack Row="true" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Timeline"
                             Color="Color.Primary"
                             Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.caption">Longest Streak</MudText>
                        <MudText Typo="Typo.h4">12 days</MudText>
                    </div>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
 
    <MudItem xs="12" md="3">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudStack Row="true" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Mood"
                             Color="Color.Success"
                             Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.caption">Most Frequent Mood</MudText>
                        <MudChip T="string" Color="Color.Success">Happy</MudChip>
                    </div>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- CHART PLACEHOLDERS -->
    <MudItem xs="12" md="4">
        <MudCard Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6">Mood Distribution</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Chart will be added later
            </MudText>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6">Weekly Entries</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Chart will be added later
            </MudText>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6">Word Count Trend</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Chart will be added later
            </MudText>
        </MudCard>
    </MudItem>

    <!-- RECENT JOURNALS -->
    <MudItem xs="12">
        <MudCard Elevation="2">
            <MudCardHeader>
                <MudText Typo="Typo.h6">Recent Journal Entries</MudText>
            </MudCardHeader>

            <MudList T="string" Dense="true">
                <MudListItem>
                    <MudText>Today — Feeling productive and focused</MudText>
                    <MudChip Color="Color.Success" Size="Size.Small">Happy</MudChip>
                </MudListItem>

                <MudListItem>
                    <MudText>Yesterday — Calm but tired</MudText>
                    <MudChip Color="Color.Warning" Size="Size.Small">Neutral</MudChip>
                </MudListItem>

                <MudListItem>
                    <MudText>2 days ago — Stressful meetings</MudText>
                    <MudChip Color="Color.Error" Size="Size.Small">Stressed</MudChip>
                </MudListItem>
            </MudList>
        </MudCard>
    </MudItem>

</MudGrid>
