@page "/dashboard"
@layout MainLayout

@using JournalManagementSystem.Model
@using JournalManagementSystem.Services
@using MudBlazor

@inject IAnalyticService AnalyticService
@inject UserSessionService Session
@inject IJSRuntime JS

<MudGrid Spacing="3" Class="mb-4">

    <MudItem xs="12" md="4">
        <MudCard Class="pa-4">
            <MudStack Row="true" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook"
                         Color="Color.Primary"
                         Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.caption">Total Entries</MudText>
                    <MudText Typo="Typo.h5">@summary?.TotalEntries</MudText>
                </div>
            </MudStack>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard Class="pa-4">
            <MudStack Row="true" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Mood"
                         Color="Color.Success"
                         Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.caption">Most Frequent Mood</MudText>
                    <MudChip T = "string" Color="Color.Success">
                        @summary?.MostFrequentMood
                    </MudChip>
                </div>
            </MudStack>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard Class="pa-4">
            <MudStack Row="true" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Label"
                         Color="Color.Info"
                         Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.caption">Most Used Tag</MudText>
                    <MudChip T="string" Color="Color.Info">
                        @summary?.MostUsedTag
                    </MudChip>
                </div>
            </MudStack>
        </MudCard>
    </MudItem>

</MudGrid>


<MudGrid Spacing="3">

    <MudItem xs="12" md="4">
        <MudCard Class="pa-4">
            <MudText Typo="Typo.h6">Mood Distribution</MudText>
            <canvas id="moodChart" width="300" height="250"></canvas>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard Class="pa-4">
            <MudText Typo="Typo.h6">Tag Distribution</MudText>
            <canvas id="tagChart" width="300" height="250"></canvas>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="12">
        <MudCard Class="pa-4">
            <MudText Typo="Typo.h6">Word Count Trend</MudText>
            <canvas id="wordTrendChart" width="800" height="300"></canvas>
        </MudCard>
    </MudItem>

</MudGrid>

@code {
    private AnalyticDisplayModel? analytics;
    private DashboardSummaryModel? summary;
    private bool chartsRendered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            summary = await AnalyticService
                .GetDashboardSummaryAsync(Session.CurrentUser!.Id);

            analytics = await AnalyticService
                .GetAnalyticsAsync(Session.CurrentUser!.Id);

            StateHasChanged();
            return;
        }


        if (analytics != null && !chartsRendered)
        {
            chartsRendered = true;

            await JS.InvokeVoidAsync(
                "renderDashboardCharts",
                analytics.MoodDistribution,
                analytics.TagDistribution,
                analytics.WordCountTrend
            );
        }
    }
}

<script>
    window.renderDashboardCharts = (moodData, tagData, wordData) => {
        renderPieChart("moodChart", moodData);
        renderPieChart("tagChart", tagData);
        renderWordCountChart(wordData);
    };

    function renderPieChart(canvasId, data) {
        const ctx = document.getElementById(canvasId);
        if (!ctx) return;

        new Chart(ctx, {
            type: 'pie',
            data: {
                labels: Object.keys(data),
                datasets: [{
                    data: Object.values(data),
                    backgroundColor: Object.keys(data).map(
                        () => `hsl(${Math.random() * 360},70%,60%)`
                    )
                }]
            },
            options: {
                responsive: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
    }

    function renderWordCountChart(data) {
        const ctx = document.getElementById("wordTrendChart");
        if (!ctx) return;

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: data.map(x => new Date(x.date).toLocaleDateString()),
                datasets: [{
                    label: 'Word Count',
                    data: data.map(x => x.wordCount),
                    tension: 0.3,
                    fill: true
                }]
            },
            options: {
                responsive: false,
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    }
</script>

