@page "/journals"
@layout MainLayout
@using JournalManagementSystem.Entities
@using JournalManagementSystem.Services
@using JournalManagementSystem.Model
@inject IJournalService JournalService
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@inject IAnalyticService AnalyticService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">📓 My Journals</MudText>

    @if (!UserSession.IsLoggedIn)
    {
        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.body1" Align="Align.Center">
                Please login to view your journals.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/login"))" Class="mt-2">
                Login
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid Class="mb-4" Justify="Justify.SpaceBetween">
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => Navigation.NavigateTo("/add"))"
                           FullWidth="false">
                    Write Today
                </MudButton>
            </MudItem>
        </MudGrid>

        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudGrid Spacing="3" AlignItems="AlignItems.End">
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="TitleSearch"
                                  Label="Title"
                                  Placeholder="Search by title"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" md="2">
                    <MudSelect @bind-Value="SelectedMood"
                               Label="Mood"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               FullWidth="true">
                        <MudSelectItem Value="@("")">All</MudSelectItem>
                        <MudSelectItem Value="@("Positive")">Positive</MudSelectItem>
                        <MudSelectItem Value="@("Neutral")">Neutral</MudSelectItem>
                        <MudSelectItem Value="@("Negative")">Negative</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="2">
                    <MudTextField @bind-Value="TagSearch"
                                  Label="Tag"
                                  Placeholder="e.g. work, life"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  FullWidth="@true" />
                </MudItem>

                <MudItem xs="12" md="2">
                    <MudDatePicker @bind-Date="fromDate"
                                   Label="From"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   FullWidth="@true" />
                </MudItem>

                <MudItem xs="12" md="2">
                    <MudDatePicker @bind-Date="toDate"
                                   Label="To"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   FullWidth="@true" />
                </MudItem>

                <MudItem xs="12" md="1">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="ApplyFilters"
                               FullWidth="@true">
                        Apply
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>


        @if (!_journals.Any())
        {
            <MudPaper Class="pa-4 mt-4">
                <MudText Typo="Typo.body1" Align="Align.Center">
                    No journals found
                </MudText>
            </MudPaper>
        }
        else
        {
            @* table *@
            <MudPaper Elevation="2">
                <MudTable Items="_journals"
                          Hover="true"
                          Breakpoint="Breakpoint.Sm"
                          Dense="true">

                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>Title</MudTh>
                        <MudTh>Mood</MudTh>
                        <MudTh>Words</MudTh>
                        <MudTh Style="text-align: center; width: 220px;">Actions</MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd DataLabel="Date">@context.CreatedAt.ToString("dd MMM yyyy")</MudTd>
                        <MudTd DataLabel="Title">@context.Title</MudTd>
                        <MudTd DataLabel="Mood">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">
                                @context.PrimaryMood
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Words">@context.WordCount</MudTd>
                        <MudTd DataLabel="Actions" Style="text-align: center;">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           Title="View Journal"
                                           OnClick="@(() => ViewJournal(context.JournalId))" />

                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Warning"
                                           Size="Size.Small"
                                           Title="Edit Journal"
                                           OnClick="@(() => EditJournal(context.JournalId))" />

                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           Title="Delete Journal"
                                           OnClick="@(() => DeleteJournal(context.JournalId))" />
                        </MudTd>
                    </RowTemplate>

                </MudTable>
            </MudPaper>

            @* pagination and export *@
            <MudGrid Class="mt-4" AlignItems="AlignItems.Center">
                <MudItem xs="12" md="6">
                    <MudPagination Count="@GetTotalPages()"
                                   Selected="@currentPage"
                                   SelectedChanged="ChangePage"
                                   Color="Color.Primary"
                                   ShowFirstButton="true"
                                   ShowLastButton="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                        <MudDatePicker @bind-Date="pdfFromDate"
                                       Label="Start Date"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense" />

                        <MudDatePicker @bind-Date="pdfToDate"
                                       Label="End Date"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense" />

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                   Disabled="@(!pdfFromDate.HasValue || !pdfToDate.HasValue)"
                                   OnClick="GeneratePdf">
                            Export
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>

        }
    }
</MudContainer>


@* delete Confirmation Dialog *@
@if (showDeleteConfirm)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 9999;">
        <MudPaper Class="pa-6" Style="max-width: 500px; width: 90%;">
            <MudStack Spacing="3" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.Warning"
                         Color="Color.Error"
                         Size="Size.Large"
                         Style="font-size: 4rem;" />
                <MudText Typo="Typo.h6" Align="Align.Center">
                    Are you sure?
                </MudText>
                <MudText Typo="Typo.body1" Align="Align.Center">
                    Do you really want to delete this journal?
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Error">
                    This action cannot be undone.
                </MudText>
                <MudStack Row="true" Spacing="2" Class="mt-4">
                    <MudButton OnClick="CancelDelete"
                               Variant="Variant.Outlined"
                               Color="Color.Default">
                        Cancel
                    </MudButton>
                    <MudButton Color="Color.Error"
                               Variant="Variant.Filled"
                               OnClick="ConfirmDelete"
                               StartIcon="@Icons.Material.Filled.Delete">
                        Delete
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    </div>
}

@code {
    private List<JournalDisplayModel> _journals = new();
    private bool showDeleteConfirm = false;
    private int journalToDeleteId = 0;

    private string _titleSearch = "";
    private string _selectedMood = "";
    private string _tagSearch = "";

    string TitleSearch
    {
        get => _titleSearch;
        set
        {
            _titleSearch = value;
            if (!string.IsNullOrWhiteSpace(value))
            {
                _selectedMood = "";
                _tagSearch = "";
            }
        }
    }

    string SelectedMood
    {
        get => _selectedMood;
        set
        {
            _selectedMood = value;
            if (!string.IsNullOrWhiteSpace(value))
            {
                _titleSearch = "";
                _tagSearch = "";
            }
        }
    }

    string TagSearch
    {
        get => _tagSearch;
        set
        {
            _tagSearch = value;
            if (!string.IsNullOrWhiteSpace(value))
            {
                _titleSearch = "";
                _selectedMood = "";
            }
        }
    }

    DateTime? fromDate;
    DateTime? toDate;

    int currentPage = 1;
    int pageSize = 8;
    int totalCount = 0;

    DateTime? pdfFromDate;
    DateTime? pdfToDate;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadJournals();
    }

    private async Task LoadJournals()
    {
        (List<JournalDisplayModel> list, int count) =
            await JournalService.SearchJournalsAsync(
                UserSession.CurrentUser!.Id,
                TitleSearch,
                SelectedMood,
                TagSearch,
                fromDate,
                toDate,
                currentPage,
                pageSize);

        _journals = list;
        totalCount = count;
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadJournals();
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage < 1) return;
        currentPage = newPage;
        await LoadJournals();
    }

    private int GetTotalPages()
    {
        return (int)Math.Ceiling((double)totalCount / pageSize);
    }

    private void ViewJournal(int journalId)
    {
        Navigation.NavigateTo($"/journals/{journalId}");
    }

    private void EditJournal(int journalId)
    {
        Navigation.NavigateTo($"/edit/{journalId}");
    }

    private void DeleteJournal(int journalId)
    {
        journalToDeleteId = journalId;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        journalToDeleteId = 0;
    }

    private async Task ConfirmDelete()
    {
        var userId = UserSession.CurrentUser!.Id;
        var success = await JournalService.DeleteJournalAsync(userId, journalToDeleteId);

        if (success)
        {
            Snackbar.Add("Journal deleted successfully", Severity.Success);
            await LoadJournals();
        }
        else
        {
            Snackbar.Add("Failed to delete journal", Severity.Error);
        }

        showDeleteConfirm = false;
        journalToDeleteId = 0;
    }

    private async Task GeneratePdf()
    {
        if (!pdfFromDate.HasValue || !pdfToDate.HasValue)
            return;

        var bytes = await AnalyticService.GenerateJournalPdfAsync(
            UserSession.CurrentUser!.Id,
            pdfFromDate.Value,
            pdfToDate.Value
        );

        var base64 = Convert.ToBase64String(bytes);

        await JSRuntime.InvokeVoidAsync(
            "downloadFileFromBase64",
            $"journals_{pdfFromDate:yyyyMMdd}_{pdfToDate:yyyyMMdd}.pdf",
            base64
        );
    }

    [Inject] IJSRuntime JSRuntime { get; set; } = default!;
}

<script>
    window.downloadFileFromBase64 = (fileName, base64) => {
        const link = document.createElement("a");
        link.href = "data:application/pdf;base64," + base64;
        link.download = fileName;
        link.click();
    };
</script>
