@page "/journals"
@using MudBlazor

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Journals</MudText>

    <MudStack Row="true" Spacing="2">
        <MudToggleIconButton @bind-Toggled="_isTableView"
                             ToggledIcon="@Icons.Material.Filled.TableRows"
                             UntoggledIcon="@Icons.Material.Filled.ViewModule"
                             Color="Color.Primary" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            New Entry
        </MudButton>
    </MudStack>
</MudStack>

<!-- Filters -->
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="Search"
                          Label="Search title or tag"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>

        <MudItem xs="12" md="4">
            <MudDateRangePicker @bind-DateRange="_dateRange"
                                Label="Date Range"
                                Variant="Variant.Outlined" />
        </MudItem>

        <MudItem xs="12" md="4">
            <MudSelect T="string"
           Label="Mood"
           Variant="Variant.Outlined"
           MultiSelection="true"
           SelectedValues="_selectedMoods"
           SelectedValuesChanged="OnMoodsChanged">
    @foreach (var mood in _allMoods)
    {
        <MudSelectItem Value="@mood">@mood</MudSelectItem>
    }
</MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_isTableView)
{
    <!-- TABLE VIEW -->
    <MudTable Items="FilteredJournals" Hover="true" Elevation="1">
        <HeaderContent>
            <MudTh>Title</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Mood</MudTh>
            <MudTh>Tags</MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>@context.Title</MudTd>
            <MudTd>@context.CreatedAt.ToString("dd MMM yyyy")</MudTd>
            <MudTd>
                <MudChip T="string" Color="Color.Success" Size="Size.Small">
                    @context.PrimaryMood
                </MudChip>
            </MudTd>
            <MudTd>
                @foreach (var tag in context.Tags)
                {
                    <MudChip T="string" Size="Size.Small" Class="me-1">@tag</MudChip>
                }
            </MudTd>
            <MudTd Align="Align.Right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" />
                <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}
else
{
    <!-- CARD VIEW -->
    <MudGrid Spacing="3">
        @foreach (var journal in FilteredJournals)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6">@journal.Title</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @journal.CreatedAt.ToString("dd MMM yyyy")
                        </MudText>

                        <MudDivider Class="my-2" />

                        <MudChip T="string" Color="Color.Success" Size="Size.Small">
                            @journal.PrimaryMood
                        </MudChip>

                        <MudStack Row="true" Spacing="1" Class="mt-2">
                            @foreach (var tag in journal.Tags)
                            {
                                <MudChip T="string" Size="Size.Small">@tag</MudChip>
                            }
                        </MudStack>
                    </MudCardContent>

                    <MudCardActions Class="justify-end">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" />
                        <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" />
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
	[Inject] IDialogService DialogService { get; set; }

	private bool _isTableView = true;
	private string Search;
	private DateRange _dateRange;
	private HashSet<string> _selectedMoods = new();

	private readonly List<string> _allMoods = new()
    {
        "Happy", "Calm", "Sad", "Stressed", "Excited"
    };

	private readonly List<JournalVm> _journals = new()
    {
        new()
        {
            Title = "A Productive Day",
            CreatedAt = DateTime.Today,
            PrimaryMood = "Happy",
            Tags = new() { "Work", "Planning" }
        },
        new()
        {
            Title = "Evening Reflection",
            CreatedAt = DateTime.Today.AddDays(-1),
            PrimaryMood = "Calm",
            Tags = new() { "Personal", "Reflection" }
        },
        new()
        {
            Title = "Stressful Meeting",
            CreatedAt = DateTime.Today.AddDays(-3),
            PrimaryMood = "Stressed",
            Tags = new() { "Work" }
        }
    };

	private IEnumerable<JournalVm> FilteredJournals =>
		_journals
			.Where(j =>
				string.IsNullOrWhiteSpace(Search) ||
				j.Title.Contains(Search, StringComparison.OrdinalIgnoreCase) ||
				j.Tags.Any(t => t.Contains(Search, StringComparison.OrdinalIgnoreCase)))
			.Where(j =>
				_dateRange?.Start == null || j.CreatedAt.Date >= _dateRange.Start.Value.Date)
			.Where(j =>
				_dateRange?.End == null || j.CreatedAt.Date <= _dateRange.End.Value.Date)
			.Where(j =>
				!_selectedMoods.Any() || _selectedMoods.Contains(j.PrimaryMood))
			.OrderByDescending(j => j.CreatedAt);

	private async Task OpenCreateDialog()
	{
		var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

		await DialogService.ShowAsync<CreateJournalDialog>("Create Journal", options);
	}

	public class JournalVm
	{
		public string Title { get; set; }
		public DateTime CreatedAt { get; set; }
		public string PrimaryMood { get; set; }
		public List<string> Tags { get; set; }
	}
	private void OnMoodsChanged(IEnumerable<string> args)
	{
		throw new NotImplementedException();
	}
}
