@page "/journals"
@using JournalManagementSystem.Entities
@using JournalManagementSystem.Services
@inject IDialogService DialogService
@inject IJournalService JournalService
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">My Journals</MudText>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="OpenCreateDialog"
               StartIcon="@Icons.Material.Filled.Add"
               Class="mb-4">
        Create New Journal
    </MudButton>

    @if (!_journals.Any())
    {
        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.body1" Align="Align.Center">
                No journals yet. Create your first journal to get started!
            </MudText>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            @foreach (var journal in _journals)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Class="cursor-pointer" @onclick="@(() => ViewJournal(journal.Id))">
                        <MudCardContent>
                            <MudText Typo="Typo.h6">@journal.Title</MudText>
                            <MudText Typo="Typo.body2" Class="mt-2">
                                @((MarkupString)TruncateHtml(journal.DescriptionHtml, 100))
                            </MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="mt-2">
                                @journal.PrimaryMood
                            </MudChip>
                            @foreach (var mood in journal.SecondaryMoods)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">
                                    @mood
                                </MudChip>
                            }
                        </MudCardContent>
                        <MudCardActions>
                            <MudText Typo="Typo.caption" Class="ml-2">
                                @journal.CreatedAt.ToString("MMM dd, yyyy")
                            </MudText>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private List<Journal> _journals = new();

    protected override void OnInitialized()
    {
        LoadJournals();
    }

    private void LoadJournals()
    {
        _journals = JournalService.GetAllJournals();
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<CreateJournalDialog>("Create New Journal", options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is Journal model)
        {
            JournalService.CreateJournal(model);
            LoadJournals();
        }
    }

    private void ViewJournal(Guid id)
    {
        Navigation.NavigateTo($"/journals/{id}");
    }

    private string TruncateHtml(string html, int maxLength)
    {
        var text = System.Text.RegularExpressions.Regex.Replace(html, "<.*?>", string.Empty);
        if (text.Length <= maxLength)
            return text;

        return text.Substring(0, maxLength) + "...";
    }
}

<style>
    .cursor-pointer {
        cursor: pointer;
    }

        .cursor-pointer:hover {
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            transform: translateY(-2px);
            transition: all 0.3s ease;
        }
</style>