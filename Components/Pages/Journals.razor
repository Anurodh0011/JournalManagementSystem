@page "/journals"
@layout MainLayout
@using JournalManagementSystem.Entities
@using JournalManagementSystem.Services
@using JournalManagementSystem.Model
@inject IJournalService JournalService
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@inject IAnalyticService AnalyticService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">My Journals</MudText>

    @if (!UserSession.IsLoggedIn)
    {
        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.body1" Align="Align.Center">
                Please login to view your journals.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/login"))" Class="mt-2">
                Login
            </MudButton>
        </MudPaper>
    }
    else
    {
        

        @if (!_journals.Any())
        {
            <MudPaper Class="pa-4 mt-4">
                <MudText Typo="Typo.body1" Align="Align.Center">
                    No journals yet. Create your first journal to get started!
                </MudText>
            </MudPaper>
        }
        else
        {
          <MudGrid Class="mb-4" Justify="Justify.SpaceBetween">
    <MudItem xs="12" md="4">
        <MudTextField @bind-Value="_searchText"
                      Placeholder="Search by title or content..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Margin="Margin.Dense"
                      FullWidth="true" />
    </MudItem>

    <MudItem xs="12" md="4" Class="d-flex justify-end">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Navigation.NavigateTo("/add"))"
                   Class="w-100 w-md-auto"
                   Style="height: 40px;">
            Create New Journal
        </MudButton>
    </MudItem>
</MudGrid>


            <MudGrid Class="mb-4">
        <MudItem xs="12" md="4">
            <MudDatePicker Label="From Date"
                           @bind-Date="pdfFromDate"
                           MaxDate="DateTime.Today" />
        </MudItem>

        <MudItem xs="12" md="4">
            <MudDatePicker Label="To Date"
                           @bind-Date="pdfToDate"
                           MaxDate="DateTime.Today" />
        </MudItem>

        <MudItem xs="12" md="4" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PictureAsPdf"
                       Disabled="@(pdfFromDate == null || pdfToDate == null)"
                       OnClick="GeneratePdf">
                Export PDF
            </MudButton>
        </MudItem>
    </MudGrid>
          <MudTable Items="_filteredJournals"
          Hover="true"
          Breakpoint="Breakpoint.Sm"
          Dense="true"
          RowsPerPage="10"
          @bind-CurrentPage="_currentPage">

    <HeaderContent>
        <MudTh>Title</MudTh>
        <MudTh>Created Date</MudTh>
        <MudTh>Primary Mood</MudTh>
        <MudTh>Secondary Moods</MudTh>
        <MudTh>Tags</MudTh>
        <MudTh>Word Count</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Title">@context.Title</MudTd>
        <MudTd DataLabel="Created Date">@context.CreatedAt.ToString("MMM dd, yyyy")</MudTd>

        <MudTd DataLabel="Primary Mood">
            <MudChip T="string" Size="Size.Small" Color="Color.Primary">
                @context.PrimaryMood
            </MudChip>
        </MudTd>

        <MudTd DataLabel="Secondary Moods">
            @if (context.SecondaryMoods?.Any() == true)
            {
                @foreach (var mood in context.SecondaryMoods)
                {
                    <MudChip T="string" Size="Size.Small"
                             Color="Color.Secondary"
                             Class="mr-1">
                        @mood
                    </MudChip>
                }
            }
            else
            {
                <MudText Typo="Typo.caption">-</MudText>
            }
        </MudTd>

        <MudTd DataLabel="Tags">
            @if (context.Tags?.Any() == true)
            {
                @foreach (var tag in context.Tags)
                {
                    <MudChip T="string" Size="Size.Small"
                             Color="Color.Info"
                             Variant="Variant.Outlined"
                             Class="mr-1">
                        @tag
                    </MudChip>
                }
            }
            else
            {
                <MudText Typo="Typo.caption">-</MudText>
            }
        </MudTd>

        <MudTd DataLabel="Word Count">@context.WordCount</MudTd>

        <MudTd DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                           Color="Color.Info"
                           Size="Size.Small"
                           OnClick="@(() => ViewJournal(context.JournalId))" />

            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Color="Color.Warning"
                           Size="Size.Small"
                           OnClick="@(() => EditJournal(context.JournalId))" />

            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Color="Color.Error"
                           Size="Size.Small"
                           OnClick="@(() => DeleteJournal(context.JournalId))" />
        </MudTd>
    </RowTemplate>

    <!-- 👇 Pagination BELOW the table -->
    <PagerContent>
        <MudTablePager />
    </PagerContent>

</MudTable>

        }
    }
</MudContainer>


@* Delete Confirmation Dialog *@
@if (showDeleteConfirm)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 9999;">
        <MudPaper Class="pa-6" Style="max-width: 500px; width: 90%;">
            <MudStack Spacing="3" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.Warning"
                         Color="Color.Error"
                         Size="Size.Large"
                         Style="font-size: 4rem;" />
                <MudText Typo="Typo.h6" Align="Align.Center">
                    Are you sure?
                </MudText>
                <MudText Typo="Typo.body1" Align="Align.Center">
                    Do you really want to delete this journal?
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Error">
                    This action cannot be undone.
                </MudText>
                <MudStack Row="true" Spacing="2" Class="mt-4">
                    <MudButton OnClick="CancelDelete"
                               Variant="Variant.Outlined"
                               Color="Color.Default">
                        Cancel
                    </MudButton>
                    <MudButton Color="Color.Error"
                               Variant="Variant.Filled"
                               OnClick="ConfirmDelete"
                               StartIcon="@Icons.Material.Filled.Delete">
                        Delete
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    </div>
}

@code {
    private List<JournalDisplayModel> _journals = new();
    private bool showDeleteConfirm = false;
    private int journalToDeleteId = 0;
    private int _currentPage = 0;
    private string _searchText = string.Empty;
private List<JournalDisplayModel> _filteredJournals = new();



    protected override async Task OnInitializedAsync()
    {
        if (UserSession.IsLoggedIn)
        {
            await LoadJournalsAsync();
        }
    }

    private async Task LoadJournalsAsync()
{
    var userId = UserSession.CurrentUser!.Id;
    var result = await JournalService.GetAllJournalsByUserAsync(userId, 1, 1000);

    _journals = result.Journals;
    ApplySearchFilter();
}

private void ApplySearchFilter()
{
    if (string.IsNullOrWhiteSpace(_searchText))
    {
        _filteredJournals = _journals;
    }
    else
    {
        _filteredJournals = _journals.Where(j =>
            (!string.IsNullOrEmpty(j.Title) &&
             j.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
            ||
            (!string.IsNullOrEmpty(j.Description) &&
             j.Description.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
        ).ToList();
    }

    _currentPage = 0; // reset pagination when searching
}



    private void ViewJournal(int journalId)
    {
        Navigation.NavigateTo($"/journals/{journalId}");
    }

    private void EditJournal(int journalId)
    {
        Navigation.NavigateTo($"/edit/{journalId}");
    }

    private void DeleteJournal(int journalId)
    {
        journalToDeleteId = journalId;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        journalToDeleteId = 0;
    }

    private async Task ConfirmDelete()
    {
        var userId = UserSession.CurrentUser!.Id;
        var success = await JournalService.DeleteJournalAsync(userId, journalToDeleteId);

        if (success)
        {
            Snackbar.Add("Journal deleted successfully", Severity.Success);
            await LoadJournalsAsync();
        }
        else
        {
            Snackbar.Add("Failed to delete journal", Severity.Error);
        }

        showDeleteConfirm = false;
        journalToDeleteId = 0;
    }

    DateTime? pdfFromDate;
    DateTime? pdfToDate;

    private async Task GeneratePdf()
    {
        if (!pdfFromDate.HasValue || !pdfToDate.HasValue)
            return;

        var bytes = await AnalyticService.GenerateJournalPdfAsync(
            UserSession.CurrentUser!.Id,
            pdfFromDate.Value,
            pdfToDate.Value
        );

        var base64 = Convert.ToBase64String(bytes);

        await JSRuntime.InvokeVoidAsync(
            "downloadFileFromBase64",
            $"journals_{pdfFromDate:yyyyMMdd}_{pdfToDate:yyyyMMdd}.pdf",
            base64
        );
    }

    [Inject] IJSRuntime JSRuntime { get; set; } = default!;
}

<script>
        window.downloadFileFromBase64 = (fileName, base64) => {
        const link = document.createElement("a");
        link.href = "data:application/pdf;base64," + base64;
        link.download = fileName;
        link.click();
    };
</script>