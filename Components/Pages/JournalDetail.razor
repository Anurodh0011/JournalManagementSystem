@page "/journals/{Id:int}"
@layout MainLayout

@using JournalManagementSystem.Model
@using JournalManagementSystem.Services

@inject IJournalService JournalService
@inject UserSessionService Session
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    @if (_journal == null)
    {
        <MudText Typo="Typo.h5">Journal not found</MudText>
        <MudButton OnClick="@(() => Navigation.NavigateTo("/calendar"))" Class="mt-4">
            Go to Calendar
        </MudButton>
    }
    else
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudButton OnClick="@(() => Navigation.NavigateTo("/calendar"))" StartIcon="@Icons.Material.Filled.CalendarToday" Variant="Variant.Text">
                Back to Calendar
            </MudButton>
            <MudButton OnClick="@(() => Navigation.NavigateTo("/journals"))" StartIcon="@Icons.Material.Filled.List" Variant="Variant.Text">
                All Journals
            </MudButton>
        </MudStack>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h4" Class="mb-2">@_journal.Title</MudText>
            <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-2">
                @_journal.CreatedAt.ToString("dddd, MMMM dd, yyyy")
            </MudText>

            <MudDivider Class="mb-4" />

            <MudText Typo="Typo.subtitle2" Class="mb-2">Primary Mood</MudText>
            <MudChip T="string" Color="Color.Primary" Size="Size.Medium" Class="mb-4">
                @_journal.PrimaryMood
            </MudChip>

            @if (_journal.SecondaryMoods != null && _journal.SecondaryMoods.Any())
            {
                <MudText Typo="Typo.subtitle2" Class="mb-2">Secondary Moods</MudText>
                <div class="mb-4">
                    @foreach (var mood in _journal.SecondaryMoods)
                    {
                        <MudChip T="string" Color="Color.Secondary" Size="Size.Medium">
                            @mood
                        </MudChip>
                    }
                </div>
            }

            @if (_journal.Tags != null && _journal.Tags.Any())
            {
                <MudText Typo="Typo.subtitle2" Class="mb-2">Tags</MudText>
                <div class="mb-4">
                    @foreach (var tag in _journal.Tags)
                    {
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                            @tag
                        </MudChip>
                    }
                </div>
            }

            <MudDivider Class="mb-4" />

            <MudText Typo="Typo.subtitle2" Class="mb-2">Description</MudText>
            <div class="journal-content">
                @((MarkupString)_journal.Description)
            </div>
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }
    private JournalDisplayModel? _journal;

    protected override async Task OnInitializedAsync()
    {
        if (Session.CurrentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // fetch the journal by Id for the current user
        var (journals, _) = await JournalService.GetAllJournalsByUserAsync(Session.CurrentUser.Id, 1, 1000);
        _journal = journals.FirstOrDefault(j => j.JournalId == Id);
    }
}

<style>
    .journal-content {
        padding: 16px;
        background-color: #f5f5f5;
        border-radius: 4px;
        min-height: 200px;
    }
</style>
