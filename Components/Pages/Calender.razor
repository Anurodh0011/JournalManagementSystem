@page "/calendar"
@layout MainLayout
@using JournalManagementSystem.Entities
@using JournalManagementSystem.Model
@using JournalManagementSystem.Services
@inject IJournalService JournalService
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject UserSessionService UserSession
@inject ISnackbar Snackbar

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="">
    <MudText Typo="Typo.h4">Calendar</MudText>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="CreateTodayJournal"
               Disabled="@_journalDates.Contains(DateTime.Today)">
        @(_journalDates.Contains(DateTime.Today) ? "Today's Journal Created" : "Create Today's Journal")
    </MudButton>
</MudStack>

<MudGrid Class="my-4">
    <MudItem xs="12" sm="4">
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Current Streak</MudText>
            <MudText Typo="Typo.h5" Color="Color.Primary">2 🔥</MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Longest Streak</MudText>
            <MudText Typo="Typo.h5" Color="Color.Secondary">5🏆</MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.subtitle1" Class="mb-2">This Month</MudText>
            <MudText Typo="Typo.h5" Color="Color.Info">10 📝</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Elevation="2" Class="pa-4">
    <MudGrid>
        <MudItem xs="12">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                               OnClick="PreviousMonth"
                               Color="Color.Primary" />
                <MudText Typo="Typo.h6">@_currentMonth.ToString("MMMM yyyy")</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                               OnClick="NextMonth"
                               Color="Color.Primary" />
            </MudStack>
        </MudItem>

        <MudItem xs="12">
            <div class="calendar-grid">
                @* Day headers *@
                @foreach (var day in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
                {
                    <div class="calendar-header">@day</div>
                }

                @* Empty cells before first day of month *@
                @for (int i = 0; i < (int)new DateTime(_currentMonth.Year, _currentMonth.Month, 1).DayOfWeek; i++)
                {
                    <div class="calendar-cell empty"></div>
                }

                @* Days of the month *@
                @for (int day = 1; day <= DateTime.DaysInMonth(_currentMonth.Year, _currentMonth.Month); day++)
                {
                    var date = new DateTime(_currentMonth.Year, _currentMonth.Month, day);
                    var hasJournal = _journalDates.Contains(date.Date);
                    var isToday = date.Date == DateTime.Today;
                    var isFuture = date.Date > DateTime.Today;

                    <div class="calendar-cell @(hasJournal ? "has-journal" : "") @(isToday ? "today" : "") @(isFuture ? "future" : "")"
                         @onclick="@(() => OnDayClicked(date))"
                         style="@(isFuture ? "cursor: not-allowed; opacity: 0.5;" : "cursor: pointer;")">
                        <div class="day-number">@day</div>
                        @if (hasJournal)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                     Size="Size.Small"
                                     Color="Color.Success"
                                     Class="journal-indicator" />
                        }
                    </div>
                }
            </div>
        </MudItem>
    </MudGrid>
</MudPaper>

@* Modal for creating/editing journal *@
<MudDialog @bind-IsVisible="showJournalModal" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(selectedDate.Date == DateTime.Today ? "Today's Journal" : $"Journal for {selectedDate.ToString("MMMM dd, yyyy")}")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm>
            <MudTextField @bind-Value="journalTitle"
                          Label="Title"
                          Required="true"
                          Variant="Variant.Outlined"
                          Class="mb-3" />

            <MudTextField @bind-Value="journalContent"
                          Label="Content"
                          Required="true"
                          Lines="5"
                          Variant="Variant.Outlined"
                          Class="mb-3" />

            <MudSelect @bind-Value="journalPrimaryMood"
                       Label="Primary Mood"
                       Required="true"
                       Variant="Variant.Outlined"
                       Class="mb-3">
                <MudSelectItem Value="@("Happy")">Happy</MudSelectItem>
                <MudSelectItem Value="@("Sad")">Sad</MudSelectItem>
                <MudSelectItem Value="@("Anxious")">Anxious</MudSelectItem>
                <MudSelectItem Value="@("Calm")">Calm</MudSelectItem>
                <MudSelectItem Value="@("Excited")">Excited</MudSelectItem>
                <MudSelectItem Value="@("Angry")">Angry</MudSelectItem>
                <MudSelectItem Value="@("Grateful")">Grateful</MudSelectItem>
                <MudSelectItem Value="@("Stressed")">Stressed</MudSelectItem>
            </MudSelect>

            <MudTextField @bind-Value="secondaryMoodInput"
                          Label="Secondary Moods (comma-separated, max 2)"
                          Variant="Variant.Outlined"
                          Class="mb-3" />

            <MudTextField @bind-Value="tagsInput"
                          Label="Tags (comma-separated)"
                          Variant="Variant.Outlined"
                          Class="mb-3" />

            @if (!string.IsNullOrEmpty(formMessage))
            {
                <MudAlert Severity="@(formMessageType == "success" ? Severity.Success : Severity.Error)" Class="mb-3">
                    @formMessage
                </MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseModal" Color="Color.Default">Cancel</MudButton>
        <MudButton OnClick="SaveJournal" Color="Color.Primary" Variant="Variant.Filled">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private DateTime _currentMonth = DateTime.Today;
    private DateTime selectedDate;
    private bool showJournalModal = false;

    private string journalTitle = "";
    private string journalContent = "";
    private string journalPrimaryMood = "";

    private List<string> journalSecondaryMoods = new();
    private List<string> journalTags = new();

    private string secondaryMoodInput = "";
    private string tagsInput = "";

    private string formMessage = "";
    private string formMessageType = "danger";

    private HashSet<DateTime> _journalDates = new();
    private Dictionary<DateTime, int> _journalIdMap = new();

    private DialogOptions dialogOptions = new DialogOptions()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseButton = true,
        BackdropClick = false
    };

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadCalendarData();
    }

    private async Task LoadCalendarData()
    {
        var allJournals = await JournalService.GetAllJournalsByUserAsync(UserSession.CurrentUser!.Id, 1, 10000);
        _journalDates = allJournals.Journals.Select(j => j.CreatedAt.Date).ToHashSet();
        _journalIdMap = allJournals.Journals.ToDictionary(j => j.CreatedAt.Date, j => j.JournalId);
    }

    private async Task OnDayClicked(DateTime date)
    {
        if (date.Date > DateTime.Today)
        {
            Snackbar.Add("Cannot create journal for future dates.", Severity.Warning);
            return;
        }

        // If journal exists for this date, redirect to detail page
        if (_journalDates.Contains(date.Date))
        {
            if (_journalIdMap.TryGetValue(date.Date, out int journalId))
            {
                Navigation.NavigateTo($"/journals/{journalId}");
            }
            return;
        }

        // If no journal exists, open modal to create one
        selectedDate = date;

        journalTitle = "";
        journalContent = "";
        journalPrimaryMood = "";
        journalSecondaryMoods = new();
        journalTags = new();
        secondaryMoodInput = "";
        tagsInput = "";
        formMessage = "";

        showJournalModal = true;
    }

    private void CloseModal()
    {
        showJournalModal = false;
        formMessage = "";
    }

    private async Task SaveJournal()
    {
        if (string.IsNullOrWhiteSpace(journalTitle) || string.IsNullOrWhiteSpace(journalContent))
        {
            formMessage = "Title and content are required.";
            formMessageType = "danger";
            return;
        }

        if (string.IsNullOrWhiteSpace(journalPrimaryMood))
        {
            formMessage = "Primary mood is required.";
            formMessageType = "danger";
            return;
        }

        journalSecondaryMoods = secondaryMoodInput
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .ToList();

        journalTags = tagsInput
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        var model = new JournalViewModel
        {
            CreatedAt = selectedDate,
            Title = journalTitle,
            Description = journalContent,
            PrimaryMood = journalPrimaryMood,
            SecondaryMoods = journalSecondaryMoods,
            Tags = journalTags
        };

        var result = await JournalService.AddOrUpdateJournalAsync(UserSession.CurrentUser!.Id, model);

        if (!result.Success)
        {
            formMessage = result.ErrorMessage!;
            formMessageType = "danger";
            return;
        }

        Snackbar.Add("Journal saved successfully!", Severity.Success);

        // Reload calendar data to update the UI
        await LoadCalendarData();

        CloseModal();
    }

    private void CreateTodayJournal()
    {
        Navigation.NavigateTo("/add");
    }

    private void PreviousMonth()
    {
        _currentMonth = _currentMonth.AddMonths(-1);
    }

    private void NextMonth()
    {
        _currentMonth = _currentMonth.AddMonths(1);
    }
}

<style>
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
    }

    .calendar-header {
        text-align: center;
        font-weight: bold;
        padding: 12px;
        background-color: var(--mud-palette-primary);
        color: white;
        border-radius: 4px;
    }

    .calendar-cell {
        aspect-ratio: 1;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        transition: all 0.2s ease;
        background-color: white;
    }

        .calendar-cell:not(.empty):not(.future):hover {
            background-color: #f5f5f5;
            transform: scale(1.05);
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .calendar-cell.empty {
            background-color: transparent;
            border: none;
        }

        .calendar-cell.today {
            border: 2px solid var(--mud-palette-primary);
            background-color: #e3f2fd;
        }

        .calendar-cell.has-journal {
            background-color: #e8f5e9;
            border-color: var(--mud-palette-success);
        }

        .calendar-cell.future {
            background-color: #fafafa;
            color: #bdbdbd;
        }

    .day-number {
        font-size: 1.1rem;
        font-weight: 500;
    }

    .journal-indicator {
        position: absolute;
        bottom: 4px;
        right: 4px;
    }
</style>