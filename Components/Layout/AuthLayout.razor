@inherits LayoutComponentBase
@using MudBlazor
@inject NavigationManager Navigation

<MudThemeProvider Theme="_myCustomTheme" IsDarkMode="_isDarkMode"/>
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>

    <MudAppBar Elevation="0" Style="background: transparent; backdrop-filter: blur(10px); border-bottom: 1px solid rgba(0, 121, 107, 0.1);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Medium" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Style="font-weight: 600; color: #00796B;">
                Journal Management System
            </MudText>
        </MudStack>

        <MudSpacer />

        <MudButton Variant="@(IsLoginPage ? Variant.Filled : Variant.Text)"
                   Color="Color.Primary"
                   OnClick="@(() => NavigateToLogin())"
                   Class="mr-2">
            Login
        </MudButton>

        <MudButton Variant="@(IsSignupPage ? Variant.Filled : Variant.Text)"
                   Color="Color.Primary"
                   OnClick="@(() => NavigateToSignup())"
                   Class="mr-4">
            Sign Up
        </MudButton>

        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)"
                       Color="Color.Primary"
                       OnClick="ToggleTheme" />
    </MudAppBar>

    <MudMainContent >
        <div >
            @Body
        </div>
    </MudMainContent>

    <MudPaper Class="pa-3 text-center"
              Square="true"
              Elevation="0"
              Style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border-top: 1px solid rgba(0, 121, 107, 0.1);">
        <MudText Typo="Typo.body2" Color="Color.Primary">
            © @DateTime.Now.Year Journal Management System. All rights reserved.
        </MudText>
    </MudPaper>

</MudLayout>

@code {
    private bool _isDarkMode = false;
    private string _currentRoute = "";

    protected override void OnInitialized()
    {
        _currentRoute = Navigation?.Uri ?? "/";
        Navigation.LocationChanged += OnLocationChanged;

    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _currentRoute = e.Location;
        StateHasChanged();
    }

    private bool IsLoginPage => _currentRoute.EndsWith("/login") || _currentRoute.EndsWith("/");
    private bool IsSignupPage => _currentRoute.EndsWith("/signup") || _currentRoute.EndsWith("/register");

    private void NavigateToLogin() => Navigation.NavigateTo("/login");
    private void NavigateToSignup() => Navigation.NavigateTo("/register");

    void ToggleTheme() => _isDarkMode = !_isDarkMode;

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

   private MudTheme _myCustomTheme = new MudTheme()
    {   
        PaletteLight = new PaletteLight()
        {
            // Brand colors
            Primary = Colors.Teal.Darken3,        // Main brand / Appbar / Active
            Secondary = Colors.Pink.Default,     // Accents / Hover

            // App Backgrounds
            Background = Colors.Gray.Lighten5,   
            Surface = Colors.Shades.White,        // Cards, drawers

            // AppBar
            AppbarBackground = Colors.Teal.Darken3,
            AppbarText = Colors.Shades.White,

            // Drawer
            DrawerBackground = Colors.Shades.White,
            DrawerText = Colors.Teal.Darken3,
            DrawerIcon = Colors.Teal.Darken3,

            // Text
            TextPrimary = Colors.Teal.Darken4,
            TextSecondary = Colors.Teal.Darken1,

            ActionDefault = Colors.Teal.Darken2,  // Normal menu text

            // Feedback
            Success = Colors.Green.Darken2,
            Warning = Colors.Orange.Darken2,
            Error = Colors.Red.Darken2,
            Info = Colors.Blue.Darken2,

        },

        PaletteDark = new PaletteDark()
        {
            Primary = Colors.Teal.Lighten3,
            Secondary = Colors.Pink.Default,

            Background = "#111827",
            Surface = "#1F2937", // cards

            AppbarBackground = Colors.Teal.Darken3,
            AppbarText = Colors.Shades.White,

            DrawerBackground = "#1F2937",
            DrawerText = Colors.Teal.Lighten5,
            DrawerIcon = Colors.Teal.Lighten5,

            TextPrimary = Colors.Teal.Lighten2,

            ActionDefault = Colors.Teal.Lighten2,

            Success = Colors.Green.Lighten2,
            Warning = Colors.Orange.Lighten2,
            Error = Colors.Red.Lighten2,
            Info = Colors.Blue.Lighten2,
        },

        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "8px"
        }
    };
}
