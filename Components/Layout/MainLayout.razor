@inherits LayoutComponentBase
@using JournalManagementSystem.Model
@using MudBlazor
@using JournalManagementSystem.Services
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject UserSessionService Session

<MudThemeProvider Theme="_myCustomTheme" IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>

    @* sidebar *@
    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Mini"
               MiniVariantWidth="72px"
               Elevation="1">

        <!-- USER SUMMARY -->
        <MudPaper Class="mx-2 pa-3 my-2" Elevation="0">
            <MudStack Spacing="1" AlignItems="AlignItems.Center">
                <MudAvatar Icon="@Icons.Material.Filled.Person" Size="Size.Medium" />
                @if (_drawerOpen)
                {
                    <MudText Typo="Typo.subtitle2">
                        @_currentUsername.ToUpper()
                    </MudText>
                }
            </MudStack>
        </MudPaper>
        <div class="w-75 mx-auto" style="height:4px; background-color:#00796B;"></div>
        
        @* dynamic menu *@
        <MudNavMenu Class="mt-2">
            @foreach (var item in _navItems)
            {
                @if (item.Children != null && item.Children.Count > 0)
                {
                    <MudNavGroup Title="@(_drawerOpen? item.Title: null)" Icon="@item.Icon" Expanded="true">
                        @foreach (var child in item.Children)
                        {
                            <MudNavLink Href="@child.Href" Match="NavLinkMatch.Prefix" Icon="@child.Icon" Disabled="child.Disabled">
                                @if (_drawerOpen)
                                {
                                    <span>@child.Title</span>
                                }
                            </MudNavLink>
                        }
                    </MudNavGroup>
                }
                else
                {
                    <MudNavLink Href="@item.Href" Match="NavLinkMatch.Prefix" Icon="@item.Icon" Disabled="item.Disabled">
                        @if (_drawerOpen)
                        {
                            <span>@item.Title</span>
                        }
                    </MudNavLink>
                }
            }
        </MudNavMenu>

        <MudSpacer />

        @* quote *@
        @if (_drawerOpen)
        {
            <MudText Typo="Typo.caption" Class="pa-3 text-center">
                "Small steps every day."
            </MudText>
        }
        
        @* footer *@
        @if (_drawerOpen)
        {
            <MudPaper Class="pa-2 text-center"
                      Square="true"
                      Style="@($"background:{Colors.Teal.Darken3}; color:white;")"
                      Elevation="0">
                © @DateTime.Now.Year @_currentUsername
            </MudPaper>
        }

    </MudDrawer>

    @* app bar *@
    <MudAppBar Elevation="1" Style="@($"background:{Colors.Teal.Darken3}; color:white;")">

        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Edge="Edge.Start"
                       Color="Color.Inherit"
                       OnClick="GoBack" />
        <MudIconButton Icon="@Icons.Material.Filled.ArrowForward"
                       Edge="Edge.Start"
                       Color="Color.Inherit"
                       OnClick="GoNext" />

        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Edge="Edge.Start"
                       Color="Color.Inherit"
                       OnClick="ToggleDrawer" />

        <MudText Typo="Typo.subtitle2" Class="ml-2">
            @DateTime.Now.ToString("dddd, dd MMM")
        </MudText>

        <MudSpacer />

        <MudButton Variant="Variant.Filled"
                   OnClick="OpenCreateDialog"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Add">
            New Entry
        </MudButton>

        <MudIconButton Icon="@(_isDarkMode? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)"
                       Color="Color.Inherit"
                       OnClick="ToggleTheme" />

        <MudMenu AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight">
    <ActivatorContent>
        <MudButton Variant="Variant.Text"
                   Color="Color.Inherit"
                   EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
            <MudAvatar Icon="@Icons.Material.Filled.Person"
                       Size="Size.Small"
                       Class="mr-2" />
            @_currentUsername.ToUpper()
        </MudButton>
    </ActivatorContent>

    <ChildContent>
        <MudMenuItem Color="Color.Error" OnClick="Logout">
            Logout
        </MudMenuItem>
    </ChildContent>
</MudMenu>

    </MudAppBar>

    <MudMainContent Class="pa-4 pt-20">
        @Body
    </MudMainContent>

</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;

    private UserDisplayModel? CurrentUser;
    private string _currentUsername;

    protected override void OnInitialized()
    {
        CurrentUser = Session.GetCurrentUser();
        _currentUsername = CurrentUser?.Name;
    }

    private MudTheme _myCustomTheme = new MudTheme()
    {   
        PaletteLight = new PaletteLight()
        {
            // Brand colors
            Primary = Colors.Teal.Darken3,        // Main brand / Appbar / Active
            Secondary = Colors.Pink.Default,     // Accents / Hover

            // App Backgrounds
            Background = Colors.Gray.Lighten5,   
            Surface = Colors.Shades.White,        // Cards, drawers

            // AppBar
            AppbarBackground = Colors.Teal.Darken3,
            AppbarText = Colors.Shades.White,

            // Drawer
            DrawerBackground = Colors.Shades.White,
            DrawerText = Colors.Teal.Darken3,
            DrawerIcon = Colors.Teal.Darken3,

            // Text
            TextPrimary = Colors.Teal.Darken4,
            TextSecondary = Colors.Teal.Darken1,

            // States (IMPORTANT for NavMenu)
            ActionDefault = Colors.Teal.Darken2,  // Normal menu text

            // Feedback
            Success = Colors.Green.Darken2,
            Warning = Colors.Orange.Darken2,
            Error = Colors.Red.Darken2,
            Info = Colors.Blue.Darken2,

        },

        PaletteDark = new PaletteDark()
        {
            Primary = Colors.Teal.Lighten3,
            Secondary = Colors.Pink.Default,

            Background = "#111827",
            Surface = "#1F2937", // cards

            AppbarBackground = Colors.Teal.Darken3,
            AppbarText = Colors.Shades.White,

            DrawerBackground = "#1F2937",
            DrawerText = Colors.Teal.Lighten5,
            DrawerIcon = Colors.Teal.Lighten5,

            TextPrimary = Colors.Teal.Lighten2,

            ActionDefault = Colors.Teal.Lighten2,

            Success = Colors.Green.Lighten2,
            Warning = Colors.Orange.Lighten2,
            Error = Colors.Red.Lighten2,
            Info = Colors.Blue.Lighten2,
        },

        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "8px"
        }
    };

    public class NavItem
    {
        public string Title { get; set; }
        public string Href { get; set; }
        public string Icon { get; set; }
        public bool Disabled { get; set; } = false;
        public List<NavItem> Children { get; set; } = new();
    }

    private List<NavItem> _navItems = new()
    {
        new NavItem { Title = "Dashboard", Href = "/dashboard", Icon = Icons.Material.Filled.Dashboard },
        new NavItem { Title = "Journals", Href = "/journals", Icon = Icons.Material.Filled.MenuBook },
        new NavItem { Title = "Calendar", Href = "/calendar", Icon = Icons.Material.Filled.CalendarMonth },
        new NavItem { Title = "Calendar", Href = "/add", Icon = Icons.Material.Filled.CalendarMonth },
        new NavItem
        {
            Title = "Settings",
            Icon = Icons.Material.Filled.Settings,
            Children = new List<NavItem>
            {
                new NavItem { Title = "Profile", Href = "/settings/users", Icon = Icons.Material.Filled.Person },
                new NavItem { Title = "Security", Href = "/settings/security", Icon = Icons.Material.Filled.Security }
            }
        }
    };

    void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    void ToggleTheme() => _isDarkMode = !_isDarkMode;

    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }
    
    private async Task GoNext()
    {
        await JS.InvokeVoidAsync("history.forward");
    }

